#!/usr/bin/env python3
"""Small server command for Agente TFT trainer status; no secret is printed."""
from __future__ import annotations

import json
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path
from urllib.error import URLError
from urllib.request import urlopen

METRICS_URL = "http://127.0.0.1:8801/v1/training/dashboard-metrics"


def render(data: dict) -> str:
    def number(value, digits=1):
        return "medindo" if value is None else f"{value:.{digits}f}"

    jobs = data["jobs_by_status"]
    resources = data.get("resources") or {}
    host = resources.get("host") or {}
    container = resources.get("container") or {}
    simulator = "ativo" if data["simulator_ready"] else "ainda não ativo"
    neural = ("treino não iniciado" if data["neural_training_status"] == "not_started"
              else "novo candidato rejeitado por regressão" if data["neural_training_status"] == "regression_rejected"
              else "candidato treinado; falta validação independente")
    central = data.get("central_neural") or {}
    stable_generation = central.get("stable_generation")
    stable_version = central.get("stable_version")
    queue = central.get("queue") or {}
    sessions_by_status = central.get("sessions_by_status") or {}
    stable_text = (
        f"g{stable_generation} · {stable_version}"
        if stable_generation is not None
        else "ainda não publicado"
    )
    queue_text = (
        f"fila {queue.get('inbox', 0)} · processando {queue.get('working', 0)} · "
        f"saídas {queue.get('outbox', 0)} · falhas {queue.get('failed', 0)}"
    )

    lines = [
        "✦ AGENTE TFT · BigBANANA",
        f"Atualizado: {datetime.fromtimestamp(data['generated_at_ms'] / 1000).strftime('%d/%m/%Y %H:%M:%S')}",
        "────────────────────────────────────────",
        f"Simulador do replay: {simulator}  |  Modelo de banco/loja: {neural}",
        f"Champion neural: {stable_text}  |  {queue_text}",
        (
            "Sessões neurais: "
            f"ativas {sessions_by_status.get('active', 0)} · "
            f"processando {sessions_by_status.get('processing', 0)} · "
            f"concluídas {sessions_by_status.get('complete', 0)} · "
            f"falhas {sessions_by_status.get('failed', 0)}"
        ),
        "Visão neural no Windows: diagnóstico local; confira a sessão do Windows.",
        f"Arquivos guardados: {data['evidence_files']}  |  Sessões: {data['sessions']}",
        f"Caminhos simulados: {data['paths_completed']}  |  Solicitados: {data['paths_requested']}",
        f"Lotes: {jobs['completed']} concluídos, {jobs['running']} em execução, {jobs['failed']} falharam",
        f"CPU BigBANANA: {number(host.get('cpu_percent')) + '%' if host.get('cpu_percent') is not None else 'medindo'}  |  "
        f"RAM: {number((host.get('memory_used_mib') or 0) / 1024) if host.get('memory_used_mib') is not None else 'indisponível'}"
        f"/{number((host.get('memory_total_mib') or 0) / 1024) if host.get('memory_total_mib') is not None else 'indisponível'} GiB",
        f"CPU contêiner TFT: {number(container.get('cpu_cores_used'), 2)}"
        f"/{number(container.get('cpu_limit_cores'))} núcleo(s)  |  "
        f"RAM: {number(container.get('memory_used_mib'))}/{number(container.get('memory_limit_mib'))} MiB",
        f"Tempo médio por lote: {data['mean_completed_job_ms'] / 1000:.2f} s"
        if data["mean_completed_job_ms"] is not None else "Tempo médio por lote: sem medição",
        "Primeira medição planejada: 50 caminhos; depois, 500 por decisão confiável.",
        "Arquivos guardados e simulações são separados do treino neural.",
    ]
    imported = data.get("latest_imported_runtime")
    if imported:
        local = "ativa na sessão gravada" if imported["diagnostic_active"] else "não confirmada"
        lines.append(f"Último replay Windows: visão diagnóstica {local} · "
                     f"{imported['mapped_frames']} mapas · "
                     f"tabuleiro validado: {'sim' if imported['board_cells_validated'] else 'não'}")
    for candidate in data.get("neural_experiments", [])[:1]:
        lines.append(f"Candidato {candidate['id']}: {candidate['source_frames']} imagens, "
                     f"{candidate['optimizer_steps']} passos, banco/loja; sem avaliação independente.")
        comparison = candidate.get("comparison")
        if candidate["status"] == "regression_rejected" and comparison:
            lines.append(f"Loja no mesmo replay: modelo anterior {comparison['previous'].get('shop:proposal', 0)}/"
                         f"{comparison['frames']}; novo {comparison['candidate'].get('shop:proposal', 0)}/"
                         f"{comparison['frames']}. Novo modelo não instalado.")
    for job in data.get('item_learning_jobs',[])[:1]:
        lines.append(f"Rede de itens: {job['status']} · {job['optimizer_steps']}/{job['optimizer_steps_total']} passos · {job['classes']} artes.")
        if job.get('replay_total'):
            lines.append(f"Recortes revisados: {job['replay_correct']}/{job['replay_total']} · {job['replay_distinct_items']} itens distintos; avaliação limitada.")
        lines.append('Escopo: reconhecimento visual de itens; não são partidas simuladas.')
    lines.extend(("", "Execuções recentes (atualização a cada 5 s):",
                  "  início    lote                 modo              feitas/pedidas  estado"))
    if not data["recent_jobs"]:
        lines.append("  Nenhum pedido de simulação do HUD.")
    for job in data["recent_jobs"][:8]:
        started = datetime.fromtimestamp(job['accepted_at_ms'] / 1000).strftime('%H:%M:%S')
        lines.append(f"  {started}  {job['job_id'][:20]:20} {job['mode'][:17]:17} "
                     f"{job['completed_paths']:4}/{job['requested_paths']:<7} "
                     f"{job['status']}" + (f" ({job['error']})" if job['error'] else ""))
    coverage = data.get('simulation_coverage')
    if coverage:
        lines.append(f"\nPatch {coverage['patch']}: {coverage['executable_abilities']}/{coverage['champions']} habilidades executáveis; treino do patch bloqueado.")
    for job in data.get('policy_learning_jobs', [])[:3]:
        lines.append(f"Laboratório {job['id']}: {job['status']} · {job['matches_completed']} partidas sintéticas completas · {job['combat_calls']} combates")
        lines.append(f"  {job['transitions']} decisões · {job['optimizer_steps']} atualizações · RAM máxima {number(job['peak_rss_mib'])} MiB · CPU {number(job['process_cpu_seconds'])} s")
        lines.append('  Candidato de laboratório; não liberado para dicas do replay.')
    for job in data.get('scene_learning_jobs', [])[:1]:
        lines.append(f"Visibilidade do tabuleiro: {job['holdout_correct']}/{job['holdout_frames']} imagens reservadas · {job['confusion_matrix'][0][1]} falsos positivos")
        lines.append(f"  {job['model_bytes']} bytes · {job['optimizer_steps']} atualizações · experimental, fora do HUD")
    return "\n".join(lines)


def fetch() -> dict:
    with urlopen(METRICS_URL, timeout=3) as response:
        return json.load(response)


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "status"
    if command == 'habilidades':
        root=Path(__file__).resolve().parents[1]/'data'
        reports=sorted(root.glob('ability-lab-*/audit.json'),key=lambda p:p.stat().st_mtime,reverse=True)
        if not reports:
            print('Ainda não há auditoria de habilidades instalada.');return 1
        path=reports[0]
        if path.is_symlink() or path.stat().st_size>2*1024*1024:
            print('Relatório inválido.');return 1
        report=json.loads(path.read_text())
        print(f"✦ AGENTE TFT · Habilidades · patch {report['patch']}")
        print(f"Regras: {report['bindings_sha256'][:12]}")
        print(f"{report['candidate_programs']}/{report['catalog_entries']} programas candidatos · {report['blocked_programs']} pendentes")
        print(f"{report['role_bound_programs']} com regra de mana · {report['replay_validated']} validados em replay")
        print('Inventário não equivale a habilidades completas. Treino do patch e HUD bloqueados.')
        for variant in report.get('scope',{}).get('alternate_forms_outside_catalog',[]):
            print(f"  Forma fora do catálogo: {variant['identity']} {variant['form']} · pendente")
        print('\nCampeão / forma                        Estado')
        for row in report['entries']:
            status='candidato' if row['status']=='candidate_not_replay_validated' else 'pendente'
            if status=='candidato' and not row['role_bound']:status+='; falta integrar mana/tempo'
            print(f"  {row['id']:36} {status}")
            for reason in row['blockers']:print('    '+reason)
        return 0
    if command in ('fontes','simulador'):
        root=Path(__file__).resolve().parents[1]/'data'
        pattern='source-corpus-*/report.json' if command=='fontes' else 'hex-lab-*/report.json'
        reports=sorted(root.glob(pattern),reverse=True)
        if not reports:
            print('Ainda não há relatório local para esta etapa.'); return 1
        path=reports[0]
        if path.is_symlink() or path.stat().st_size>2*1024*1024:
            print('Relatório inválido.'); return 1
        report=json.loads(path.read_text())
        print('✦ AGENTE TFT · '+('Fontes de referência' if command=='fontes' else 'Simulador experimental'))
        print('Cópia local atualizada em: '+datetime.fromtimestamp(path.stat().st_mtime).isoformat(timespec='seconds'))
        if command=='fontes':
            count=sum(s['segments']>0 for s in report['sources'])
            print(f"{count} fontes com texto · {report['segments']} trechos indexados")
            print(f"Ações com resultado rotulado: {report['action_outcome_labels']}")
            print('Transcrição e legenda são referências; não comprovam treino de decisões.')
        else:
            print(f"{report['matches_completed']} partidas sintéticas completas · {report['combat_calls']} combates")
            search=report.get('search') or {}
            print(f"Busca: {search.get('simulation_paths',0)} caminhos · {search.get('elapsed_seconds',0):.2f} s")
            print(f"RAM máxima: {report['peak_rss_mib']:.1f} MiB")
            print('Regras de laboratório. Patch completo e dicas do HUD ainda não liberados.')
            candidates=sorted(root.glob('event-lab-*/report.json'),key=lambda p:p.stat().st_mtime,reverse=True)
            if candidates:
                candidate_path=candidates[0]
                if not candidate_path.is_symlink() and candidate_path.stat().st_size<=2*1024*1024:
                    event=json.loads(candidate_path.read_text())
                    print('\nMotor de eventos: '+event.get('status','desconhecido'))
                    identity=event.get('data_identity')
                    if identity:print(f"  Patch: {identity['patch']} · regras: {identity['bindings_sha256'][:12]}")
                    print(f"  {event.get('combat_calls',0)} combates · {event.get('complete_matches',0)} partidas completas · {event.get('elapsed_seconds',0):.2f} s")
                    if event.get('peak_rss_mib') is not None:print(f"  RAM máxima: {event['peak_rss_mib']:.1f} MiB")
                    coverage=event.get('coverage',{})
                    for label,key in [('Campeões','champions'),('Itens/componentes','items'),('Sinergias','traits')]:
                        value=coverage.get(key,{})
                        print(f"  {label}: {value.get('candidate_effects',0)} implementados em laboratório · {value.get('replay_validated',0)} validados em replay")
                    neural=event.get('neural',{})
                    if neural:
                        print(f"  Rede: {neural.get('optimizer_steps',0)} atualizações · {neural.get('parameters',0)} parâmetros")
                        evaluation=neural.get('final_validation',{})
                        print(f"  Avaliação: {evaluation.get('accuracy',0):.1%} em {evaluation.get('samples',0)} tabuleiros reservados do simulador")
                    print('  Não comprova acurácia no TFT real; modelo fora do HUD.')
        return 0
    if command in ("web", "navegador"):
        print("Painel web no próprio servidor: http://127.0.0.1:8801/dashboard")
        return 0
    if command in ("neural-deploy", "ia-deploy"):
        script=Path(__file__).resolve().with_name("deploy_bigbanana_neural.sh")
        if not script.is_file():
            print("Deploy neural indisponível: script não encontrado.", file=sys.stderr)
            return 1
        result=subprocess.run(["bash",str(script)])
        return result.returncode
    if command in ("neural", "ia"):
        try:
            data=fetch()
        except (URLError, TimeoutError, OSError, ValueError) as exc:
            print(f"Agente TFT indisponível: {exc}", file=sys.stderr)
            return 1
        central=data.get("central_neural") or {}
        queue=central.get("queue") or {}
        sessions=central.get("sessions_by_status") or {}
        print("✦ AGENTE TFT · IA CENTRAL")
        print(f"Backend: {central.get('learning_backend','desconhecido')}")
        generation=central.get('stable_generation')
        version=central.get('stable_version')
        print("Stable: "+(f"g{generation} · {version}" if generation is not None else "ainda não publicado"))
        print(f"Fila: {queue.get('inbox',0)} esperando · {queue.get('working',0)} processando · {queue.get('failed',0)} falhas")
        print(f"Sessões: {sessions}")
        print("Treino pesado: BigBANANA · inferência: modelo aprovado local")
        return 0
    if command not in ("status", "acompanhar", "watch", "painel", "panel"):
        print("Uso: tft [status|painel|neural|neural-deploy|web|fontes|simulador|habilidades]", file=sys.stderr)
        return 2
    try:
        while True:
            if command != "status" and sys.stdout.isatty():
                print("\033[2J\033[H", end="")
            print(render(fetch()), flush=True)
            if command == "status":
                return 0
            time.sleep(5)
    except KeyboardInterrupt:
        return 0
    except (URLError, TimeoutError, OSError, ValueError) as exc:
        print(f"Agente TFT indisponível: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
