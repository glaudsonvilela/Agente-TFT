FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY training/simulator_lab/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r /tmp/requirements.txt
COPY scripts/bootstrap_tft_goat.sh scripts/bootstrap_tft_goat.sh
RUN bash scripts/bootstrap_tft_goat.sh && git config --system --add safe.directory /app/training/upstream/TFT_GOAT
COPY training/simulator_lab training/simulator_lab
COPY configs/simulation configs/simulation
RUN useradd --uid 10001 --create-home worker && mkdir /data && chown worker:worker /data
USER worker
# Isolated lab; explicit command required. Never auto-promote a model.
ENTRYPOINT ["python", "-m", "training.simulator_lab.selfplay", "--project", "/app"]
CMD ["--help"]
